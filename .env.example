# =================================================================
# CLIENT INFRASTRUCTURE CONFIGURATION
# =================================================================

# Unique prefix for isolated Docker networks and containers ej. acl-server
COMPOSE_PROJECT_NAME=login-infinyti

# Main domain for routing ej. infinyti.local
CLIENT_DOMAIN=example.local

# Certificate resolver: empty for local (mkcert), "letsencrypt" for production
CERT_RESOLVER=

# ACME Email for Let's Encrypt SSL certificates in production
ACME_EMAIL=admin@example.com

# =================================================================
# DATABASE CONFIGURATION (SHARED)
# =================================================================
DB_ROOT_PASSWORD=root
DB_DATABASE=if_dev_login
DB_USER=example
DB_PASSWORD=root

# MONGO CONFIGURATION
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=root

# REDIS CONFIGURATION
REDIS_PASSWORD=root

# =================================================================
# DIGITALOCEAN SPACES & BACKUPS CONFIGURATION
# =================================================================
SPACES_KEY=your_spaces_access_key
SPACES_SECRET=your_spaces_secret_key
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=your_bucket_name
SPACES_REGION=us-east-1
SPACES_ROOT=backups-db-prod

# GFS retention policy configuration (optional, defaults shown)
# RETENTION_HOURLY_HOURS=48
# RETENTION_DAILY_DAYS=30
# RETENTION_WEEKLY_WEEKS=8
# RETENTION_MONTHLY_MONTHS=12

# Webhook notification URL (compatible with Discord or Slack)
NOTIFICATION_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url