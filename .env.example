# =================================================================
# CLIENT INFRASTRUCTURE CONFIGURATION
# =================================================================
# Unique prefix for isolated Docker networks and containers (ej. client-infra)
COMPOSE_PROJECT_NAME=domain-infra

# Main domain for routing (ej. domain.example o domain.localhost en local)
CLIENT_DOMAIN=domain.example

# Certificate resolver: empty for local (mkcert wildcard), "letsencrypt" for production
CERT_RESOLVER=local-acme

# CA certificates for local step-ca (Leave empty or commented out for production/letsencrypt)
LEGO_CA_CERTIFICATES=/certs/root_ca.crt

# ACME Email for Let's Encrypt SSL certificates in production
ACME_EMAIL=admin@domain.example

# -----------------------------------------------------------------
# TRAEFIK DASHBOARD BASIC AUTH
# -----------------------------------------------------------------
# Generar hash en terminal:
#   echo $(htpasswd -nb admin tu_password)
# O con docker:
#   docker run --rm httpd:alpine htpasswd -nbB admin tu_password
#
# ⚠️ IMPORTANTE: Docker Compose interpreta los signos '$' como variables.
# Para evitar errores, debes escapar cada '$' duplicándolo como '$$'.
# Ejemplo: si el hash es 'admin:$apr1$xyz$123', define 'admin:$$apr1$$xyz$$123'
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xyz...

# -----------------------------------------------------------------
# SUBDOMINIOS PERSONALIZABLES (OPCIONALES - VALORES POR DEFECTO)
# -----------------------------------------------------------------
# Si no se definen, toman automáticamente los valores por defecto:
SUBDOMAIN_TRAEFIK=traefik-internal
SUBDOMAIN_CENTRIFUGO=realtime
SUBDOMAIN_REDISINSIGHT=redis
SUBDOMAIN_QUEUES=queues
SUBDOMAIN_DBGATE=db
SUBDOMAIN_MAILPIT=mail
SUBDOMAIN_MINIO=s3
SUBDOMAIN_MINIO_CONSOLE=s3-console
SUBDOMAIN_EVOLUTION=whatsapp

# -----------------------------------------------------------------
# COMPOSE PROFILES (MODULARIDAD DE SERVICIOS)
# -----------------------------------------------------------------
# Controla qué módulos opcionales se inician junto con el núcleo base (Traefik + BDs).
# Puedes definir uno o varios perfiles separados por coma.
#
# Opciones disponibles:
#   - dev / local     : Inicia TODO el stack (Centrifugo, RedisInsight, Bull-Board, DbGate, Mailpit, S3, WhatsApp)
#   - realtime        : Inicia solo Centrifugo (WebSockets / Tiempo Real)
#   - tools           : Inicia herramientas administrativas (DbGate, Mailpit, RedisInsight, Bull-Board)
#   - redisinsight    : Inicia solo panel RedisInsight (https://redis.<dominio>)
#   - queues          : Inicia solo panel Bull-Board (https://queues.<dominio>)
#   - mail            : Inicia solo Mailpit (servidor SMTP / visor de correos)
#   - dbgate          : Inicia solo DbGate (gestor web de BDs)
#   - s3 / minio      : Inicia servidor MinIO (S3 local)
#   - whatsapp        : Inicia Evolution API (WhatsApp REST API)
#   - (dejar vacío)   : Inicia únicamente servicios core (Traefik, MySQL, PostgreSQL, MongoDB, Redis)
#
# Ejemplos de uso:
#   COMPOSE_PROFILES=realtime,redisinsight
#   COMPOSE_PROFILES=realtime,queues,s3
#   COMPOSE_PROFILES=dev
COMPOSE_PROFILES=local

# =================================================================
# DATABASES CONFIGURATION (CORE)
# =================================================================

# --- MySQL Configuration ---
DB_ROOT_PASSWORD=SuperSecretRootPass123!

# Bases de datos creadas automáticamente por init-db.sh (puedes añadir MYSQL_DB_2_*, etc.)
MYSQL_DB_1_NAME=app_db
MYSQL_DB_1_USER=app_user
MYSQL_DB_1_PASS=SuperSecretUserPass123!

# Variables para compatibilidad de aplicaciones
DB_DATABASE=app_db
DB_USER=app_user
DB_PASSWORD=SuperSecretUserPass123!

# --- PostgreSQL Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuperSecretPostgresPass123!
POSTGRES_DB=default_db

# --- MongoDB Configuration ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=SuperSecretMongoPass123!

# --- Redis Configuration (con persistencia AOF en disco) ---
REDIS_PASSWORD=SuperSecretRedisPass123!

# =================================================================
# REALTIME & WEBSOCKETS (CENTRIFUGO)
# =================================================================
# Clave secreta HMAC para generación y validación de tokens JWT de clientes
CENTRIFUGO_SECRET=SuperSecretCentrifugoTokenKey_2026

# Clave de API para que los backends (PHP, Python, Rust, Node) publiquen eventos vía HTTP (/api)
CENTRIFUGO_API_KEY=SuperSecretCentrifugoApiKey_2026

# Credenciales para el dashboard administrativo web de Centrifugo (https://realtime.<domain>)
CENTRIFUGO_ADMIN_PASSWORD=SuperSecretCentrifugoAdminPass123!
CENTRIFUGO_ADMIN_SECRET=SuperSecretCentrifugoAdminSecretKey_2026

# =================================================================
# OPTIONAL SERVICES CONFIGURATION (MINIO & EVOLUTION API)
# =================================================================

# --- MinIO (S3 Local Storage) ---
MINIO_ROOT_USER=admin_minio
MINIO_ROOT_PASSWORD=SuperSecretMinioPass123!

# --- Evolution API (WhatsApp Gateway) ---
WA_API_KEY=SecretEvolutionApiKey_2026

# =================================================================
# DIGITALOCEAN SPACES & BACKUPS CONFIGURATION (PROD / CRON)
# =================================================================
SPACES_KEY=your_spaces_access_key
SPACES_SECRET=your_spaces_secret_key
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=your_bucket_name
SPACES_REGION=us-east-1
SPACES_ROOT=backups-db-prod

# Política de retención GFS (Grandfather-Father-Son) - Opcional
RETENTION_HOURLY_HOURS=48
RETENTION_DAILY_DAYS=30
RETENTION_WEEKLY_WEEKS=8
RETENTION_MONTHLY_MONTHS=12

# Webhook de notificación para Discord o Slack en ejecución de backups
NOTIFICATION_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url